# Ignore the generated output inside public, but keep the source folder
public/*
!.gitkeep

# Environment vars
.env

# Auto-generated by giallo (Zola syntax highlighting). With style="class"
# Zola writes these into static/ on every build; we don't link them
# (highlight colours come from the --md-code-block-* token mapping in
# sass/_markdown.scss), so keep them out of version control.
static/giallo*.css

# macOS artifacts
.DS_Store
